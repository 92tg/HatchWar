local function findZone(zoneRoot, number)
    local exactName = ORB_ZONES[number]
    if not zoneRoot or not exactName then return nil end

    local zone = zoneRoot:FindFirstChild(exactName)
    if zone then return zone end

    for _, child in ipairs(zoneRoot:GetChildren()) do
        if tonumber(child.Name:match("^%s*(%d+)")) == number then
            return child
        end
    end
    return nil
end

local function getBounds(instance)
    local minV, maxV
    local parts = {}

    local function addPart(part)
        local cf = part.CFrame
        local size = part.Size
        parts[#parts + 1] = { cf = cf, size = size }
        local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector

        local half = Vector3.new(
            math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(look.X) * size.Z,
            math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(look.Y) * size.Z,
            math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(look.Z) * size.Z
        ) * 0.5

        local pMin = cf.Position - half
        local pMax = cf.Position + half

        minV = minV and minV:Min(pMin) or pMin
        maxV = maxV and maxV:Max(pMax) or pMax
    end

    if instance:IsA("BasePart") then addPart(instance) end
    for _, d in ipairs(instance:GetDescendants()) do
        if d:IsA("BasePart") then addPart(d) end
    end
    return minV, maxV, parts
end

local function orbZoneCandidates(number)
    local list = {}
    local pattern = "^" .. number .. "%s*[|_]"

    local okI, I = pcall(function() return require(RS.Library.Client.InstancingCmds) end)
    if okI and type(I) == "table" and type(I.GetModel) == "function" then
        local okM, model = pcall(I.GetModel)
        if okM and typeof(model) == "Instance" then
            for _, child in ipairs(model:GetChildren()) do
                if child.Name:match(pattern) then list[#list + 1] = child end
            end
        end
    end

    local fallback = findZone(getZoneRoot(), number)
    if fallback then list[#list + 1] = fallback end
    return list
end

local zoneInfoCache = {}
local function getZoneInfo(number)
    local now = os.clock()
    local info = zoneInfoCache[number]
    if info then
        if info.bounds and now - info.at < 30 then return info end
        if not info.bounds and now - info.at < 1 then return info end
    end

    info = { at = now }
    zoneInfoCache[number] = info
    for _, zone in ipairs(orbZoneCandidates(number)) do
        local minV, maxV, parts = getBounds(zone)
        if minV and maxV then
            info.bounds = { min = minV, max = maxV }
            info.parts = parts
            break
        end
    end
    return info
end

local function getOrbZoneBounds()
    return getZoneInfo(C.orbZone).bounds
end

local function inOrbBounds(pos, bounds)
    return pos.X >= bounds.min.X and pos.X <= bounds.max.X and pos.Z >= bounds.min.Z and pos.Z <= bounds.max.Z
end

local function flatDistance(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local orbOwner = {}

local function footprintDistance(parts, pos)
    local best = math.huge
    for _, part in ipairs(parts) do
        local rel = part.cf:PointToObjectSpace(pos)
        local dx = math.max(math.abs(rel.X) - part.size.X / 2, 0)
        local dz = math.max(math.abs(rel.Z) - part.size.Z / 2, 0)
        local d = math.sqrt(dx * dx + dz * dz)
        if d < best then
            best = d
            if d == 0 then break end
        end
    end
    return best
end

local function orbOwnerZone(key, pos)
    local now = os.clock()
    local cached = orbOwner[key]
    if cached and cached.pos == pos and (cached.complete or now - cached.at < 5) then return cached.zone end

    local candidates, complete = {}, true
    for number = 1, 4 do
        local info = getZoneInfo(number)
        if info.bounds then
            if inOrbBounds(pos, info.bounds) then candidates[#candidates + 1] = number end
        else
            complete = false
        end
    end

    local owner = candidates[1]
    if #candidates > 1 then
        local bestD, bestC
        for _, number in ipairs(candidates) do
            local info = zoneInfoCache[number]
            local d = footprintDistance(info.parts, pos)
            local center = (info.bounds.min + info.bounds.max) / 2
            local c = flatDistance(center, pos)
            if not bestD or d < bestD - 0.01 or (math.abs(d - bestD) <= 0.01 and c < bestC) then
                bestD, bestC, owner = d, c, number
            end
        end
    end

    orbOwner[key] = { pos = pos, zone = owner, complete = complete, at = now }
    return owner
end

