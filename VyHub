local hoverboardHooked = false
local function installHoverboardSteering()
    if hoverboardHooked then
        local cls = C._hbClass
        local okC, current = pcall(function() return cls and cls.ComputeMoveDirection end)
        if okC and current ~= nil and current == C._hbHook then return true end
        hoverboardHooked = false
    end

    local class
    local playerScripts = lp:FindFirstChild("PlayerScripts")
    if playerScripts then
        for _, d in ipairs(playerScripts:GetDescendants()) do
            if d:IsA("ModuleScript") and d.Name == "HoverboardInstance" then
                local ok, mod = pcall(require, d)
                if ok and type(mod) == "table" and type(mod.ComputeMoveDirection) == "function" then
                    class = mod
                    break
                end
            end
        end
    end
    if not class then return false end

    if C._hbClass ~= class or type(C._hbOriginal) ~= "function" then
        C._hbClass = class
        C._hbOriginal = class.ComputeMoveDirection
    end
    local original = C._hbOriginal

    pcall(function() if setreadonly then setreadonly(class, false) end end)
    local hook = function(self, ...)
        local target = C.orbTarget
        if target and C.orb and alive() and self._isLocal then
            local root = self._humanoidRootPart
            if root then
                local flat = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
                if flat.Magnitude > 0.5 then return flat.Unit end
                return Vector3.zero
            end
        end
        return original(self, ...)
    end
    local okSet = pcall(function() class.ComputeMoveDirection = hook end)
    if not okSet then return false end

    C._hbHook = hook
    hoverboardHooked = true
    return true
end

local getupvalues = (debug and debug.getupvalues) or getupvalues
local orbsModule, orbsModuleTriedAt = nil, 0

local function getActiveOrbs()
    if not orbsModule then
        if os.clock() - orbsModuleTriedAt < 5 then return nil, "module" end
        orbsModuleTriedAt = os.clock()
        local ok, mod = pcall(function() return require(RS.Library.Client.HatchWarCmds.Orbs) end)
        if not (ok and type(mod) == "table") then return nil, "module" end
        orbsModule = mod
    end

    if type(orbsModule.Bank) == "function" then
        local okB, bank, bankMax = pcall(orbsModule.Bank)
        if okB and type(bank) == "number" and type(bankMax) == "number" and bankMax > 0 and bankMax <= bank then
            return nil, "bank full"
        end
    end

    local remove = type(orbsModule.Networking) == "table" and orbsModule.Networking["HW_Orbs_Remove"] or nil
    if type(getupvalues) ~= "function" or type(remove) ~= "function" then return nil, "data" end

    local okU, ups = pcall(getupvalues, remove)
    if okU and type(ups) == "table" then
        local firstTable
        for _, v in pairs(ups) do
            if type(v) == "table" then
                firstTable = firstTable or v
                for _, orb in pairs(v) do
                    if type(orb) == "table" and typeof(orb.Position) == "Vector3" then return v end
                    break
                end
            end
        end
        if firstTable then return firstTable end
    end
    return nil, "data"
end

local chaseKey, chaseStartedAt = nil, 0
local chaseBestDist, chaseProgressAt, chaseArrivedAt = math.huge, 0, nil

local function clearChase()
    C.orbTarget = nil
    chaseKey = nil
    chaseArrivedAt = nil
end

local function collectNextOrb(myRun)
    restoreIdentity()
    local active, why = getActiveOrbs()
    restoreIdentity()
    if not active then
        clearChase()
        setStatus(why == "bank full" and "orb bank full - waiting" or "waiting for the orb data...")
        task.wait(1)
        return
    end

    local bounds = getOrbZoneBounds()
    restoreIdentity()
    if not bounds then
        clearChase()
        setStatus(("zone %d not found - waiting for the event..."):format(orbZoneNumber))
        task.wait(1)
        return
    end

    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        clearChase()
        task.wait(0.5)
        return
    end

    local now = os.clock()
    local rootPos = root.Position
    local chosenZone = C.orbZone
    local freshKey, freshOrb, freshDist
    local skipKey, skipOrb, skipDist
    local stickyOrb, stickyDist
    local total, inZone = 0, 0
    for key, orb in pairs(active) do
        if type(orb) == "table" and typeof(orb.Position) == "Vector3" then
            total += 1
            if orbOwnerZone(key, orb.Position) == chosenZone then
                inZone += 1
                local skipUntil = orbBlacklist[key]
                if skipUntil and skipUntil <= now then
                    orbBlacklist[key] = nil
                    skipUntil = nil
                end
                local d = flatDistance(orb.Position, rootPos)
                if skipUntil then
                    if not skipDist or d < skipDist then skipKey, skipOrb, skipDist = key, orb, d end
                else
                    if not freshDist or d < freshDist then freshKey, freshOrb, freshDist = key, orb, d end
                    if key == chaseKey then stickyOrb, stickyDist = orb, d end
                end
            end
        end
    end
    for key in pairs(orbBlacklist) do
        if active[key] == nil then orbBlacklist[key] = nil end
    end
    for key in pairs(orbOwner) do
        if active[key] == nil then orbOwner[key] = nil end
    end

    local nearestKey, nearest, nearestDist = freshKey, freshOrb, freshDist
    local retrying = false
    if not nearest then
        nearestKey, nearest, nearestDist = skipKey, skipOrb, skipDist
        retrying = nearest ~= nil
    elseif stickyOrb and nearestKey ~= chaseKey and stickyDist <= nearestDist + HW_STICKY then
        nearestKey, nearest, nearestDist = chaseKey, stickyOrb, stickyDist
    end

    if not nearest then
        clearChase()
        if inZone == 0 and total > 0 then
            setStatus(("zone %d | no orbs in this zone (%d elsewhere) - check the zone number"):format(orbZoneNumber, total))
        else
            setStatus(("zone %d | waiting for orbs (%d in zone, %d total)"):format(orbZoneNumber, inZone, total))
        end
        task.wait(0.25)
        return
    end

    if nearestKey ~= chaseKey then
        chaseKey = nearestKey
        chaseStartedAt = now
        chaseBestDist = nearestDist
        chaseProgressAt = now
        chaseArrivedAt = nil
    else
        if nearestDist < chaseBestDist - HW_PROGRESS_STEP then
            chaseBestDist = nearestDist
            chaseProgressAt = now
        end
        if nearestDist <= HW_ARRIVE_RADIUS then
            chaseArrivedAt = chaseArrivedAt or now
        else
            chaseArrivedAt = nil
        end

        local stall = tonumber(C.hwMoveTimeout) or HW_MOVE_TIMEOUT
        if chaseArrivedAt and now - chaseArrivedAt >= HW_ARRIVE_WAIT then
            orbBlacklist[nearestKey] = now + HW_RETRY_TIME
            clearChase()
            return
        elseif now - chaseProgressAt >= stall or now - chaseStartedAt >= HW_MAX_CHASE then
            orbBlacklist[nearestKey] = now + (tonumber(C.hwBlacklistTime) or HW_BLACKLIST_TIME)
            clearChase()
            return
        end
    end

    local doing = retrying and "retrying a skipped orb" or "collecting"
    if not inOrbBounds(rootPos, bounds) then doing = "riding to the zone, " .. doing end
    setStatus(("zone %d | %s (%d in zone, %d total)"):format(orbZoneNumber, doing, inZone, total))
    if C._orbRun == myRun then C.orbTarget = nearest.Position end
    task.wait(0.05)
end

local function orbWorker(myRun)
    task.wait(0.5)
    restoreIdentity()
    local lastEquip = os.clock()
    local failures, lastErr = 0, nil

    while orbActive(myRun) do
        restoreIdentity()

        local ok, err = pcall(function()
            if orbZoneNumber ~= C.orbZone then
                orbZoneNumber = C.orbZone
                orbBlacklist = {}
                orbBounds = nil
                clearChase()
            end

            if not hoverboardOn() then
                clearChase()
                setStatus("equipping hoverboard...")
                if os.clock() - lastEquip >= 3 then
                    lastEquip = os.clock()
                    fireNetwork("Hoverboard_RequestEquip")
                end
                task.wait(0.3)
            elseif not installHoverboardSteering() then
                clearChase()
                setStatus("waiting for the hoverboard module...")
                task.wait(0.5)
            else
                collectNextOrb(myRun)
            end
        end)

        if ok then
            failures = 0
        else
            failures += 1
            local msg = tostring(err)
            if msg ~= lastErr then
                lastErr = msg
                log("Orb error:", msg)
            end
            if failures >= 5 then
                clearChase()
                setStatus("error - " .. msg)
            end
            task.wait(0.2)
        end

        task.wait(0.05)
    end
end

local function startOrb()
    orbBlacklist = {}
    orbBounds = nil
    orbZoneNumber = C.orbZone
    clearChase()

    C._orbRun = (C._orbRun or 0) + 1
    local myRun = C._orbRun

    fireNetwork("Hoverboard_RequestEquip")
    pcall(installHoverboardSteering)
    setStatus("started - " .. ORB_ZONES[orbZoneNumber])
    task.spawn(orbWorker, myRun)
end

local function stopOrb()
    C._orbRun = (C._orbRun or 0) + 1
    C.orbTarget = nil
    fireNetwork("Hoverboard_RequestUnequip")
    setStatus("stopped")
end

local startBoss, stopBoss
local bossLabel

do
    local BOSS_PATH = { "INTERACT", "Bosses", "Boss4", "BossRig" }
    local BOSS_OFFSET = Vector3.new(0, 3, 0)
    local BOSS_FALLBACK = Vector3.new(6950, 16, 21980)
    local TELEPORT_EVERY = 2
    local START_EVERY = 2
    local FIGHT_IDLE = 6
    local START_GRACE = 8
    local CIRCLE_WAIT = 10
    local FIGHT_MAX = 90
    local PRESS_E_EVERY = 5

    local CIRCLE_NAME = "LiveCircle"
    local METHOD = "auto"
    local REACTION_DELAY = { 0.04, 0.12 }
    local RETRY_AFTER = 0.15
    local MAX_TRIES = 6
    local MAX_TAPS_PER_SEC = 8
    local CLICK_OFFSET_X, CLICK_OFFSET_Y = 0, 0

    local circles = {}
    local lastCircleAt = -math.huge
    local stats = { hit = 0, lost = 0, taps = 0 }
    local wins = { click = 0, signal = 0 }
    local HAS_SIGNAL = type(firesignal) == "function" or type(getconnections) == "function"
    local bossState = "idle"

    local function rand(a, b) return a + math.random() * (b - a) end

    local function setBossState(text)
        if text ~= bossState then
            bossState = text
            log("Boss:", text)
        end
    end

    local HatchWarBoss = nil
    local function loadBossModule()
        if HatchWarBoss then return end
        pcall(function()
            local node = RS
            for _, name in ipairs({ "Library", "Util", "HatchWarBoss" }) do
                node = node and node:FindFirstChild(name)
            end
            if node then HatchWarBoss = require(node) end
        end)
    end
    loadBossModule()

    local function tapInterval()
        local rate = MAX_TAPS_PER_SEC
        if HatchWarBoss and type(HatchWarBoss.ClicksPerSecondCap) == "function" then
            local ok, cap = pcall(HatchWarBoss.ClicksPerSecondCap)
            if ok and type(cap) == "number" and cap > 0 then
                rate = math.min(rate, cap * 0.8)
            end
        end
        return 1 / math.max(rate, 1)
    end

    local function track(obj)
        if circles[obj] or not obj:IsA("GuiButton") then return end
        local now = os.clock()
        lastCircleAt = now
        circles[obj] = {
            born = now,
            ready = now + rand(REACTION_DELAY[1], REACTION_DELAY[2]),
            last = -math.huge,
            tries = 0,
        }
    end

    local function scanCircles()
        local playerGui = lp:FindFirstChild("PlayerGui")
        if not playerGui then return end
        for _, d in ipairs(playerGui:GetDescendants()) do
            if d.Name == CIRCLE_NAME then track(d) end
        end
    end

    local playerGui = lp:FindFirstChild("PlayerGui")
    if playerGui then
        table.insert(C._efConns, playerGui.DescendantAdded:Connect(function(d)
            if C.autoBoss and d.Name == CIRCLE_NAME then track(d) end
        end))
    end

    local function guiInset(gui)
        local screen = gui:FindFirstAncestorWhichIsA("ScreenGui")
        if screen then
            if screen.IgnoreGuiInset then return 0, 0 end
            local ok, noInset = pcall(function()
                local mode = screen.ScreenInsets
                return mode == Enum.ScreenInsets.None or mode == Enum.ScreenInsets.DeviceSafeInsets
            end)
            if ok and noInset then return 0, 0 end
        end
        local inset = GuiService:GetGuiInset()
        return inset.X, inset.Y
    end

    local function clickPoint(btn)
        local size = btn.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then return nil end
        local pos = btn.AbsolutePosition
        local ix, iy = guiInset(btn)
        local x = math.floor(pos.X + size.X * 0.5 + ix + CLICK_OFFSET_X + 0.5)
        local y = math.floor(pos.Y + size.Y * 0.5 + iy + CLICK_OFFSET_Y + 0.5)
        local cam = workspace.CurrentCamera
        if cam then
            local vp = cam.ViewportSize
            if x < 0 or y < 0 or x > vp.X or y > vp.Y then return nil end
        end
        return x, y
    end

    local function tapClick(btn)
        if not VirtualInputManager then return false end
        local x, y = clickPoint(btn)
        if not x then return false end
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
        return true
    end

    local function fireSignal(signal, ...)
        if type(firesignal) == "function" then
            return (pcall(firesignal, signal, ...))
        end
        if type(getconnections) == "function" then
            local args = { ... }
            local ok, conns = pcall(getconnections, signal)
            if ok and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    pcall(function() c:Fire(table.unpack(args)) end)
                end
                return true
            end
        end
        return false
    end

    local function tapSignal(btn)
        if not HAS_SIGNAL then return false end
        local p = btn.AbsolutePosition
        local input = {
            UserInputType = Enum.UserInputType.MouseButton1,
            UserInputState = Enum.UserInputState.Begin,
            KeyCode = Enum.KeyCode.Unknown,
            Position = Vector3.new(p.X, p.Y, 0),
        }
        local a = fireSignal(btn.InputBegan, input)
        local b = fireSignal(btn.Activated, input, 1)
        local c = fireSignal(btn.MouseButton1Click)
        return a or b or c
    end

    local function primaryMethod()
        if METHOD == "click" then return "click" end
        if METHOD == "signal" then return HAS_SIGNAL and "signal" or "click" end
        if HAS_SIGNAL and wins.signal >= wins.click + 2 then return "signal" end
        return "click"
    end

    local function methodFor(info)
        local first = primaryMethod()
        if info.tries % 2 == 0 then return first end
        if METHOD == "auto" and HAS_SIGNAL then
            return first == "click" and "signal" or "click"
        end
        return first
    end

    local function tappable(btn)
        if not btn.Visible then return false end
        local screen = btn:FindFirstAncestorWhichIsA("ScreenGui")
        if screen and not screen.Enabled then return false end
        local size = btn.AbsoluteSize
        return size.X > 0 and size.Y > 0
    end

    local function tapCircle(btn, info)
        local method = methodFor(info)
        info.tries += 1
        info.last = os.clock()
        stats.taps += 1

        local sent
        if method == "signal" then
            sent = tapSignal(btn)
        else
            sent = tapClick(btn)
            if not sent and METHOD == "auto" and HAS_SIGNAL then
                method = "signal"
                sent = tapSignal(btn)
            end
        end
        info.method = method
    end

    local function pressE()
        if not VirtualInputManager then return end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end

    local function bossPivot()
        local node = getZoneRoot()
        for _, name in ipairs(BOSS_PATH) do
            node = node and node:FindFirstChild(name)
        end
        if not node then return nil end
        local ok, cf = pcall(function() return node:GetPivot() end)
        if ok and typeof(cf) == "CFrame" then return cf end
        return nil
    end

    local function teleportToBoss(root)
        if not getZoneRoot() then return nil, false end

        local pivot = bossPivot()
        local destination = pivot and (pivot.Position + BOSS_OFFSET) or BOSS_FALLBACK
        local rotation = root.CFrame - root.CFrame.Position

        root.CFrame = CFrame.new(destination) * rotation
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        return destination, pivot ~= nil
    end

    task.spawn(function()
        local lastTap = -math.huge
        while alive() do
            if not (C.running and C.autoBoss) then
                task.wait(0.2)
            else
                task.wait()
                local ok, err = pcall(function()
                    local now = os.clock()
                    local best, bestInfo
                    for btn, info in pairs(circles) do
                        if btn.Name ~= CIRCLE_NAME then
                            stats.hit += 1
                            if info.method then wins[info.method] += 1 end
                            circles[btn] = nil
                        elseif btn.Parent == nil then
                            stats.lost += 1
                            circles[btn] = nil
                        elseif info.tries < MAX_TRIES and info.ready <= now
                            and now - info.last >= RETRY_AFTER and tappable(btn) then
                            if not best or info.born < bestInfo.born then best, bestInfo = btn, info end
                        end
                    end

                    if best and not GuiService.MenuIsOpen and now - lastTap >= tapInterval() then
                        lastTap = now
                        tapCircle(best, bestInfo)
                    end
                end)
                if not ok then log("Boss tap error:", err) end
            end
        end
    end)

    local StartRemote = nil
    local function getStartRemote()
        if StartRemote and StartRemote.Parent then return StartRemote end
        local net = RS:FindFirstChild("Network")
        StartRemote = net and net:FindFirstChild("Instancing_InvokeCustomFromClient")
        return StartRemote
    end

    local starting, startedAt, graceUntil, remoteAt = false, 0, 0, nil
    local useRemote, remoteConfirmed, lastReason = true, false, nil

    local function fightActive(now)
        return (starting and now - startedAt < FIGHT_MAX)
            or now < graceUntil
            or now - lastCircleAt < FIGHT_IDLE
    end

    local function startFight()
        local now = os.clock()
        if starting and now - startedAt >= FIGHT_MAX then starting = false end
        if useRemote then
            local remote = getStartRemote()
            if remote then
                if starting then return end
                starting, startedAt = true, now
                task.spawn(function()
                    local ok, a, b = pcall(function()
                        return remote:InvokeServer("HatchWar", "HW_Boss_Start", 4)
                    end)
                    starting = false
                    if ok and a ~= false then
                        graceUntil, remoteAt, lastReason = os.clock() + START_GRACE, os.clock(), nil
                        log("Boss: fight started (remote)")
                    else
                        local why = tostring(ok and b or a)
                        if why ~= lastReason then
                            lastReason = why
                            log("Boss: start refused -", why)
                        end
                    end
                end)
                return
            end
        end
        graceUntil = now + PRESS_E_EVERY
        pressE()
    end

    task.spawn(function()
        local lastTeleport, lastStart, wasOn = -math.huge, -math.huge, false

        while alive() do
            task.wait(0.1)

            if not (C.running and C.autoBoss) then
                if wasOn then
                    wasOn = false
                    setBossState("idle")
                end
                task.wait(0.3)
            else
                if not wasOn then
                    wasOn = true
                    lastTeleport, lastStart, graceUntil = -math.huge, -math.huge, 0
                    useRemote, remoteConfirmed, remoteAt, lastReason = true, false, nil, nil
                end

                local ok, err = pcall(function()
                    local char = lp.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not (hum and root and hum.Health > 0) then
                        task.wait(0.5)
                        return
                    end
                    if not getZoneRoot() then
                        setBossState("waiting for HatchWar")
                        task.wait(0.5)
                        return
                    end

                    local now = os.clock()

                    if now - lastTeleport >= TELEPORT_EVERY then
                        lastTeleport = now
                        teleportToBoss(root)
                    end

                    -- remote-only start: make sure the game really opened its circles, else use E
                    if useRemote and remoteAt and not remoteConfirmed then
                        if lastCircleAt >= startedAt then
                            remoteConfirmed = true
                        elseif now - remoteAt > CIRCLE_WAIT and not starting then
                            useRemote = false
                            log("Boss: remote started a fight but no circles showed - starting with E instead")
                        end
                    end

                    if fightActive(now) then
                        setBossState("fighting")
                    elseif now - lastStart >= START_EVERY then
                        lastStart = now
                        setBossState("starting fight")
                        if not GuiService.MenuIsOpen then startFight() end
                    end
                end)
                if not ok then log("Boss loop error:", err) end
            end
        end
    end)

    task.spawn(function()
        while alive() do
            if bossLabel then
                if C.autoBoss then
                    bossLabel.Text = ("Boss: %s | hit %d | lost %d | taps %d"):format(bossState, stats.hit, stats.lost, stats.taps)
                else
                    bossLabel.Text = "Boss: idle"
                end
            end
            task.wait(0.5)
        end
    end)

    startBoss = function()
        loadBossModule()
        table.clear(circles)
        scanCircles()
        setBossState("starting")
    end

    stopBoss = function()
        table.clear(circles)
    end
end

